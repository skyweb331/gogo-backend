# ---------------------------------------------------------------------------
# nxpay-backend environment. Copy to .env and fill in.
# Files are loaded in this order (first wins): .env.$NODE_ENV.local, .env.$NODE_ENV, .env.local, .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Postgres (Docker postgres is published on 5433; Homebrew Postgres usually on 5432)
DATABASE_URL=postgres://nxpay:nxpay@localhost:5433/nxpay
# Log every SQL statement (development only)
DB_LOG_QUERIES=false
# Local only: new sign-ups skip the emailed verification code (ignored in production)
SKIP_EMAIL_VERIFICATION=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public URLs used in emails and Bridge redirect_uri
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Issuer name shown in authenticator apps for admin TOTP
TOTP_ISSUER=NxPay Admin

# Initial super admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@nxpay.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=NxPay Admin
# First fee schedule month (YYYY-MM). Defaults to the current UTC month.
SEED_FEE_EFFECTIVE_PERIOD=

# ---------------------------------------------------------------------------
# Bridge
# ---------------------------------------------------------------------------
# sandbox | production
BRIDGE_ENV=sandbox
BRIDGE_API_URL=https://api.sandbox.bridge.xyz
BRIDGE_API_KEY=sk-test-xxxxxxxx
# PEM public key from the Bridge dashboard (use \n for newlines)
BRIDGE_WEBHOOK_PUBLIC_KEY=
# Chain of the Bridge custodial wallet created per customer: base | solana
CUSTODIAL_CHAIN=base
# Default payout chain for generated wallets: base | solana
DEFAULT_PAYOUT_CHAIN=base
# Poller interval in minutes (sandbox 2, production 10)
BRIDGE_POLL_INTERVAL_MINUTES=2
# Smallest net payout Bridge accepts, in cents
BRIDGE_MIN_TRANSFER_IN_CENTS=100
# Log redacted Bridge request bodies (ignored in production)
BRIDGE_LOG_BODIES=false

# ---------------------------------------------------------------------------
# Background jobs (pg-boss, schema "pgboss" in the same database)
# ---------------------------------------------------------------------------
# Set false to run an API-only process
JOBS_ENABLED=true

# ---------------------------------------------------------------------------
# Wallet key vault (envelope encryption, AES-256-GCM)
# Generate a key: npm run keys:generate
# ---------------------------------------------------------------------------
# Production: path to a secret file with one `version:base64key` per line
WALLET_MASTER_KEYS_FILE=
# Development only (refused when NODE_ENV=production): comma-separated `version:base64key`
WALLET_MASTER_KEYS=
# Version used to seal new wallet keys
WALLET_MASTER_KEY_CURRENT=v1
# Alert the ops address when more than this many key exports happen in one hour
WALLET_EXPORT_ALERT_PER_HOUR=10
# Max key exports per customer per day
WALLET_EXPORT_LIMIT_PER_DAY=3

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# ses | log   (log prints emails and writes HTML to tmp/mail/; refused in production)
MAIL_TRANSPORT=log
MAIL_FROM=NxPay <no-reply@nxpay.local>
OPS_ALERT_EMAIL=ops@nxpay.local
# SES only. The IAM user needs ses:SendEmail and nothing else.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Compliance / ops
# ---------------------------------------------------------------------------
# Comma-separated ISO country codes and US state codes where signup is blocked
BLOCKED_COUNTRIES=
BLOCKED_US_STATES=NY,TX
# Optional Sentry DSN
SENTRY_DSN=
