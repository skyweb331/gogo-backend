[
  {
    "id": "column.public.users.approvedAt",
    "label": "Add column \"approvedAt\" to \"users\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "approvedAt",
        "table": "users"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"approvedAt\" is missing",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "users",
          "approvedAt"
        ]
      }
    ],
    "execute": [
      {
        "description": "add column \"approvedAt\"",
        "sql": "ALTER TABLE \"public\".\"users\" ADD COLUMN \"approvedAt\" timestamptz(3)"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"approvedAt\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "users",
          "approvedAt"
        ]
      }
    ]
  },
  {
    "id": "data.users.approvedAt.backfill",
    "label": "Approve existing users",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "set approvedAt = createdAt for existing users",
        "sql": "UPDATE \"public\".\"users\" SET \"approvedAt\" = \"createdAt\" WHERE \"approvedAt\" IS NULL"
      }
    ],
    "postcheck": [
      {
        "description": "every existing user is approved",
        "sql": "SELECT NOT EXISTS (SELECT 1 FROM \"public\".\"users\" WHERE \"approvedAt\" IS NULL) AS \"result\""
      }
    ]
  }
