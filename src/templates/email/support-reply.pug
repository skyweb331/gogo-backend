extends layout.pug
include mixins.pug

block content
  p Hi #{name},
  p Our support team replied to your ticket <strong>#{subjectLine}</strong>:
  blockquote(style="margin:16px 0;padding:12px 16px;border-left:3px solid #3d5afe;background:#f4f5f7;white-space:pre-wrap;")= body
  +button(frontendUrl + '/support/' + ticketId, 'Open ticket')
