extends layout.pug
include mixins.pug

block content
  p Hi #{name},
  p The private key for your #{chainName} wallet was exported from #{appName}.
  +rows([['Wallet', address], ['Time (UTC)', time], ['IP address', ip || 'unknown']])
  p Anyone with this key controls the funds in the wallet. Keep it offline and never share it. If this wasn't you, contact support immediately.
