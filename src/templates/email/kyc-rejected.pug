extends layout.pug
include mixins.pug

block content
  p Hi #{name},
  p Unfortunately we couldn't verify your identity.
  if reasons && reasons.length
    p Reasons provided by our verification partner:
    ul
      each reason in reasons
        li= reason
  p You may be able to resubmit with updated information.
  +button(frontendUrl + '/onboarding', 'Review status')
