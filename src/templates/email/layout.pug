doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="color-scheme" content="light")
    title= subject
  body(style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2430;")
    table(role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:40px 16px;")
      tr
        td(align="center")
          table(role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border:1px solid #e6e8ee;border-radius:16px;overflow:hidden;")
            tr
              td(style="height:4px;line-height:4px;font-size:0;background-color:#b23ca6;background-image:linear-gradient(90deg,#d152c4,#95288a);") &nbsp;
            tr
              td(style="padding:28px 40px 20px;border-bottom:1px solid #eceef3;")
                a(href=frontendUrl style="text-decoration:none;")
                  img(src="cid:" + logoCid alt=appName width="104" height="28" style="display:block;width:104px;height:28px;border:0;outline:none;")
            tr
              td(style="padding:32px 40px 36px;font-size:15px;line-height:1.6;")
                block content
            tr
              td(style="padding:20px 40px 28px;font-size:12px;line-height:1.6;color:#7a8194;background:#fafbfc;border-top:1px solid #eceef3;")
                block footer
                  | You are receiving this email because you have an account with #{appName}.
                  br
                  | © #{year} #{appName}
