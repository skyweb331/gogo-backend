extends layout.pug
include mixins.pug

block content
  p Hi #{name},
  p You have been added to the #{appName} admin console as #{role}. Set your password to get started; you'll be asked to set up two-factor authentication on first sign-in.
  +button(link, 'Set password')
  p This link expires in 60 minutes. Ask an administrator for a new invite if it expires.
